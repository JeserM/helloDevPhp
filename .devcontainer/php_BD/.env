# Configuración de la base de datos
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=db
MYSQL_USER=user
MYSQL_PASSWORD=password

# Configuración de phpMyAdmin
PMA_HOST= db
PMA_PORT= 3306
# PMA_USER: ${MYSQL_USER}
# PMA_PASSWORD: ${MYSQL_PASSWORD}

# Control de phpMyAdmin (1 para activarlo, 0 para desactivarlo)
ENABLE_PHPMYADMIN=1